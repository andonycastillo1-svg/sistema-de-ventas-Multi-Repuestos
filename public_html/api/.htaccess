RewriteEngine On

# Pasar Authorization header a PHP
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Bloquear bots/crawlers de la API
RewriteCond %{HTTP_USER_AGENT} (bot|crawler|spider|slurp|googlebot|bingbot|baidu|yandex) [NC]
RewriteRule .* - [F,L]

# Sin listado de directorio
Options -Indexes
